# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Required: your OpenAI (or OpenAI-compatible) API key.
OPENAI_API_KEY=sk-your-api-key-here

# Optional: override the API base URL, e.g. to point at an OpenAI-compatible
# gateway/proxy instead of https://api.openai.com/v1. Leave unset to use the
# default OpenAI endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: chat model name. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# Optional: search strategy — filter (Phase 1, default), tfidf (Phase 2) or embedding (Phase 3).
# CONSULTANT_BOT_SEARCH_STRATEGY=filter
# CONSULTANT_BOT_SEARCH_TOP_K=5
# CONSULTANT_BOT_LLM_TEMPERATURE=0.3
# Optional: product catalog to load. Defaults to products.json at the repo root.
# CONSULTANT_BOT_PRODUCTS_PATH=/path/to/products.json
